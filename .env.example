# Copy this file to .env and fill in what you need. Never commit .env.
# Every setting below has a working default, so an empty .env is fine.

# --- Providers ---
# Comma-separated, any combination of:
#   xotelo   - free hotel prices from several booking sites plus TripAdvisor
#              review scores. No key needed. This is the default.
#   serpapi  - Google Hotels results through SerpApi: Google ratings, prices,
#              amenities. Needs SERPAPI_KEY below (free plan available).
#   demo     - made-up sample hotels, no network at all. Good for trying the
#              UI offline. Never mix with real providers in one search.
ENABLED_PROVIDERS=xotelo

# --- SerpApi (optional, only used when "serpapi" is enabled) ---
# Get a key at https://serpapi.com (the free plan is a few hundred searches a month).
SERPAPI_KEY=
# Hard stop for SerpApi calls per calendar month. When reached, the provider
# reports "quota_exhausted" instead of spending more of your plan.
SERPAPI_MONTHLY_BUDGET=200

# --- Xotelo ---
XOTELO_BASE_URL=https://data.xotelo.com/api
# How many hotel rate lookups may run at the same time. Keep this low, the
# API is free and shared by everyone.
XOTELO_MAX_CONCURRENCY=4
# How Xotelo orders a city's hotel list: best_value, popularity or distance.
XOTELO_LIST_SORT=best_value

# --- Storage ---
DATABASE_PATH=data/hotels.db

# --- Caching (seconds, 0 disables) ---
SEARCH_CACHE_TTL_SECONDS=900
RATES_CACHE_TTL_SECONDS=1800
EXCHANGE_RATE_CACHE_TTL_SECONDS=3600

# --- Display ---
# Prices are stored in USD (the provider currency). This only picks the
# currency the UI shows by default. Users can switch it in the app.
DEFAULT_DISPLAY_CURRENCY=SGD

# --- Watcher ---
# How often saved watches are re-checked in the background.
CHECK_INTERVAL_HOURS=6
SCHEDULER_ENABLED=true

# --- Network / logging ---
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# --- Map tiles (frontend, applied at build time) ---
# Default is OpenStreetMap's standard tiles, darkened in CSS. That is fine for
# personal use under https://operations.osmfoundation.org/policies/tiles/ but
# not for a busy public site. To use another raster provider, set its URL
# template and attribution here. Set VITE_TILE_DARKEN=false if the tiles are
# already dark.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
VITE_TILE_DARKEN=true
